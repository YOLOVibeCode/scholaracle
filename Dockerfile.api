# Dockerfile for API Server
# Uses BuildKit for better caching and performance

# syntax=docker/dockerfile:1.4

# Base stage - install dependencies
FROM node:20-alpine AS base
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package files
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/database/package.json ./packages/database/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/interfaces/package.json ./packages/interfaces/
COPY packages/workers/package.json ./packages/workers/
COPY packages/agents/package.json ./packages/agents/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Development stage
FROM base AS development
COPY . .
RUN pnpm --filter @scholaracle/api build
EXPOSE 3002
CMD ["pnpm", "--filter", "@scholaracle/api", "dev"]

# Production stage
FROM base AS production
COPY . .
RUN pnpm --filter @scholaracle/api build
EXPOSE 3002
CMD ["pnpm", "--filter", "@scholaracle/api", "start"]
