# Dockerfile for Workers Service
# Uses BuildKit for better caching and performance.
# Uses node:20-slim + Playwright Chromium for Skyward browser-based scraping.
# Updated: 2026-03-06

# syntax=docker/dockerfile:1.4

# Base stage - install dependencies and Chromium for Playwright
FROM node:20-slim AS base
WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@8.15.0 --activate

# Copy package files (ALL workspace packages required for frozen lockfile)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/database/package.json ./packages/database/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/interfaces/package.json ./packages/interfaces/
COPY packages/agents/package.json ./packages/agents/
COPY packages/workers/package.json ./packages/workers/
COPY packages/connector/package.json ./packages/connector/
COPY packages/web/package.json ./packages/web/
COPY packages/e2e/package.json ./packages/e2e/

# Install dependencies
RUN pnpm install --frozen-lockfile

    # Install Chromium for Skyward browser scraper (connector depends on playwright)
    # Use pnpm exec since playwright is in the workspace
    RUN pnpm exec playwright install --with-deps chromium

# Development stage
FROM base AS development
COPY . .
RUN pnpm --filter @scholaracle/workers... build
EXPOSE 3003
CMD ["pnpm", "--filter", "@scholaracle/workers", "dev"]

# Production stage
FROM base AS production
COPY . .
RUN pnpm --filter @scholaracle/workers... build
ENV NODE_ENV=production
EXPOSE 3003
CMD ["node", "packages/workers/dist/worker.js"]
