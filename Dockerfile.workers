# Dockerfile for Workers Service
# Google Classroom / OneRoster sync + digests/alerts — no Playwright/Chromium.
#
# Build with: docker build -f Dockerfile.workers .

# syntax=docker/dockerfile:1.4

FROM node:20-slim AS base
WORKDIR /app

# pnpm 9 matches lockfileVersion 9.0; avoid corepack on newer Node 20 patches
RUN npm install -g pnpm@9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/database/package.json ./packages/database/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/interfaces/package.json ./packages/interfaces/
COPY packages/agents/package.json ./packages/agents/
COPY packages/workers/package.json ./packages/workers/
COPY packages/connector/package.json ./packages/connector/
COPY packages/web/package.json ./packages/web/
COPY packages/e2e/package.json ./packages/e2e/
COPY packages/scraper-core/package.json ./packages/scraper-core/
COPY packages/scraper-playwright/package.json ./packages/scraper-playwright/
COPY packages/mobile/package.json ./packages/mobile/
COPY packages/browser-extension/package.json ./packages/browser-extension/
COPY packages/logger/package.json ./packages/logger/
COPY packages/studio-core/package.json ./packages/studio-core/

RUN pnpm install --no-frozen-lockfile

# Development stage. Build it by name: --target development.
FROM base AS development
COPY . .
RUN pnpm --filter @scholaracle/workers... build
RUN cp -r packages/contracts/dist node_modules/.pnpm/file+packages+contracts/node_modules/@scholaracle/contracts/dist 2>/dev/null || true
EXPOSE 3003
CMD ["pnpm", "--filter", "@scholaracle/workers", "dev"]

# Production stage. Keep it LAST: Railway and CI build without a target, so
# they get the last stage. The dev command above (ts-node-dev --respawn) does
# not exit when the worker crashes, so Railway would never restart it.
# Guarded by packages/workers/src/production-image.test.ts.
FROM base AS production
COPY . .
RUN pnpm --filter @scholaracle/workers... build
RUN cp -r packages/contracts/dist node_modules/.pnpm/file+packages+contracts/node_modules/@scholaracle/contracts/dist 2>/dev/null || true
ENV NODE_ENV=production
EXPOSE 3003
CMD ["node", "packages/workers/dist/worker.js"]
