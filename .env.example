# =============================================================================
# Scholaracle Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- Core ---
NODE_ENV=development
PORT=3001

# --- MongoDB ---
# For local development: mongodb://localhost:27017
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# For in-memory (E2E testing): memory
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=scholaracle

# --- Authentication ---
# REQUIRED in production. Any random 256-bit string.
JWT_SECRET=change-me-in-production
# Short-lived access token (e.g. 15m, 1h). Fallback: JWT_EXPIRES_IN.
JWT_ACCESS_EXPIRES_IN=15m
# Long-lived refresh token (e.g. 30d, 90d).
REFRESH_TOKEN_EXPIRES_IN=30d
# Session-only refresh token when "Remember me" is unchecked (e.g. 24h).
SESSION_REFRESH_TOKEN_EXPIRES_IN=24h
# Legacy: access token expiry if JWT_ACCESS_EXPIRES_IN not set.
JWT_EXPIRES_IN=15m
# Base URL for password reset links (e.g. https://app.example.com or http://localhost:3000)
BASE_URL=http://localhost:2800

# --- Data source credentials (optional) ---
# 32+ bytes or 64 hex chars. Required to store parent-entered API/portal credentials for LMS sources.
# If unset, parents can add sources but cannot save credentials (encryption will fail).
CREDENTIALS_ENCRYPTION_KEY=

# --- CORS ---
# Comma-separated list of allowed origins (API only). Production: https://scholarmancy.com,https://www.scholarmancy.com
CORS_ORIGINS=http://localhost:2800,http://localhost:3000

# --- Square Billing (optional) ---
# Obtain from https://developer.squareup.com/apps (Credentials)
SQUARE_ACCESS_TOKEN=
# sandbox or production
SQUARE_ENVIRONMENT=sandbox
# Required for payments - from Developer Console > Locations
SQUARE_LOCATION_ID=
# Application ID for web payments (optional)
SQUARE_APPLICATION_ID=
# For webhook signature verification (from Webhooks in Developer Console)
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=

# --- Email Delivery (SendGrid or SMTP) ---
# Production: Use SendGrid (set SENDGRID_API_KEY below)
# Development/Testing: Use SMTP (set SMTP_HOST + SMTP_PORT, e.g. Mailpit)
# If SMTP_HOST is set, it takes precedence over SendGrid

# SMTP (optional - for local dev with Mailpit or other SMTP server)
SMTP_HOST=
SMTP_PORT=1025

# SendGrid (optional - for production)
# Obtain from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@scholarmancy.com
SENDGRID_FROM_NAME=Scholaracle
SENDGRID_REPLY_TO=rvegajr@yolovibecodebootcamp.com

# --- Twilio SMS (optional) ---
# Obtain from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Auth token — required in production for webhook signature validation
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Messaging Service SID — enables status callbacks + opt-out handling at the service level
TWILIO_MESSAGING_SERVICE_SID=

# --- Noctusoft API Relay (optional) ---
# Route vendor API calls through the Noctusoft unified relay gateway instead of
# hitting SendGrid/Twilio/Square directly. Leave unset for direct vendor access.
# When routing via the relay:
#   - SENDGRID_API_KEY and SQUARE_ACCESS_TOKEN become relay-issued API keys
#     (the relay injects the real vendor credentials server-side)
#   - Twilio auth must use the relay's Twilio account SID / API key SID
#   - Square webhooks continue to flow DIRECTLY from Square to this app;
#     signature verification is unaffected
# SENDGRID_BASE_URL=https://api.sendgrid.noctusoft.com
# TWILIO_API_BASE_URL=https://api.twilio.noctusoft.com
# SQUARE_BASE_URL=https://connect.squareup.noctusoft.com
# Sandbox Square via relay: https://connect.squareupsandbox.noctusoft.com

# --- AI Personalization (optional) ---
# Anthropic API key for LLM-powered notification personalization
AI_API_KEY=
AI_MODEL=claude-sonnet-4-20250514

# --- Web (Next.js) ---
# URL where the API is reachable from the browser
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# --- Traklet Issue Tracker (dev-only) ---
# GitHub Personal Access Token with 'repo' scope for issue tracking
NEXT_PUBLIC_TRAKLET_PAT=
# Set to 'true' to enable the widget (dev/staging only, never in production)
NEXT_PUBLIC_TRAKLET_ENABLED=true

# --- OAuth / Auth.js (Next.js) ---
# Required for Auth.js session encryption (e.g. openssl rand -base64 32)
AUTH_SECRET=
# Shared secret for Next.js server -> Express internal calls (e.g. POST /api/auth/oauth)
INTERNAL_API_SECRET=
# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Apple OAuth (https://developer.apple.com/account/resources/identifiers/list)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=
# Microsoft (Azure AD) OAuth (https://portal.azure.com -> App registrations)
AUTH_AZURE_AD_CLIENT_ID=
AUTH_AZURE_AD_CLIENT_SECRET=
