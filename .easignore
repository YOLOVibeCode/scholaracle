# EAS build archive exclusions
# Patterns listed here are excluded from the project archive uploaded to EAS.
# Reduce archive size and avoid uploading build artifacts / dev tooling.

# Expo Go simulator app bundles downloaded locally for testing
.tmp-expo-go/
.tmp-expo-go-app/

# macOS
.DS_Store
*.pem

# Build artifacts (gitignored but listing explicitly for EAS)
# Use **/ prefix to match at any depth
**/node_modules/
**/dist/
**/.next/
**/.turbo/
**/.cache/
**/harness-output/
**/coverage/
**/.nyc_output/
packages/mobile/ios/
packages/mobile/android/
