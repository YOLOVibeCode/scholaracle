# Dockerfile for Web Application (Next.js)
# Uses BuildKit for better caching and performance

# syntax=docker/dockerfile:1.4

# Base stage - install dependencies
FROM node:20-alpine AS base
WORKDIR /app

# pnpm 9 matches lockfileVersion 9.0; avoid corepack which breaks on newer Node 20 patches
RUN npm install -g pnpm@9

# Copy package files (ALL workspace packages required for frozen lockfile)
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/database/package.json ./packages/database/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/interfaces/package.json ./packages/interfaces/
COPY packages/agents/package.json ./packages/agents/
COPY packages/workers/package.json ./packages/workers/
COPY packages/connector/package.json ./packages/connector/
COPY packages/web/package.json ./packages/web/
COPY packages/e2e/package.json ./packages/e2e/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Development stage
FROM base AS development
COPY . .
EXPOSE 3000
CMD ["pnpm", "--filter", "@scholaracle/web", "dev"]

# Production stage
FROM base AS production
COPY . .
# Next.js bakes NEXT_PUBLIC_* into the client bundle at build time. Railway passes env as build args.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter @scholaracle/web build
ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@scholaracle/web", "start"]
