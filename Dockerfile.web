# Dockerfile for Web Application (Next.js)
# syntax=docker/dockerfile:1.4

# ─── Stage 1: Install dependencies ──────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app
# pnpm 9 matches lockfileVersion 9.0; avoid corepack on newer Node 20 patches
RUN npm install -g pnpm@9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/api/package.json ./packages/api/
COPY packages/auth/package.json ./packages/auth/
COPY packages/database/package.json ./packages/database/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/interfaces/package.json ./packages/interfaces/
COPY packages/agents/package.json ./packages/agents/
COPY packages/workers/package.json ./packages/workers/
COPY packages/connector/package.json ./packages/connector/
COPY packages/web/package.json ./packages/web/
COPY packages/e2e/package.json ./packages/e2e/
RUN pnpm install --frozen-lockfile

# ─── Stage 2: Build ──────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@9

# Copy installed deps from Stage 1
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages ./packages

# Copy full source (this layer is NOT cached between stage names)
COPY . .

ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL

RUN pnpm --filter @scholaracle/web build
RUN date -u +%Y-%m-%dT%H:%M:%SZ > /app/BUILT_AT

# ─── Stage 3: Runtime ────────────────────────────────────────────────────────
FROM node:20-alpine AS production
WORKDIR /app
RUN npm install -g pnpm@9

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages ./packages
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/BUILT_AT ./BUILT_AT

ENV NODE_ENV=production
EXPOSE 3000
CMD ["pnpm", "--filter", "@scholaracle/web", "start"]
