{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @scholaracle/web build",
  "outputDirectory": "packages/web/.next",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- packages/web/ packages/contracts/ packages/interfaces/"
}
