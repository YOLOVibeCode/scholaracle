{
  "manifest_version": 3,
  "name": "Scholarmancy Sync (E2E)",
  "version": "1.0.0",
  "description": "E2E build — adds fake portal host matches for driver conformance tests only.",
  "permissions": [
    "alarms",
    "storage",
    "notifications",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*.instructure.com/*",
    "*://*.skyward.com/*",
    "*://*.iscorp.com/*",
    "*://*.aetracking.com/*",
    "*://*.aeries.net/*",
    "http://127.0.0.1:2855/*",
    "http://localhost:2855/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instructure.com/*",
        "*://*.skyward.com/*",
        "*://*.iscorp.com/*",
        "*://*.aetracking.com/*",
        "*://*.aeries.net/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["http://127.0.0.1:2855/*", "http://localhost:2855/*"],
      "js": ["e2e-conformance.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scholaracle Sync",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
