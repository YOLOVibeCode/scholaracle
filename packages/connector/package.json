{
  "name": "@scholaracle/connector",
  "version": "0.1.0",
  "description": "Scholaracle Local Connector (Node CLI) - uploads normalized academic data to Scholaracle",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slc": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "ts-node-dev --respawn --transpile-only src/cli.ts",
    "harness": "ts-node --transpile-only src/harness/harness.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:strict": "eslint src --ext .ts --max-warnings=0",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@google/generative-ai": "^0.24.0",
    "@scholaracle/contracts": "workspace:*",
    "axios": "^1.13.5",
    "mongodb": "^6.3.0",
    "openai": "^6.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
