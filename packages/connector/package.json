{
  "name": "@scholaracle/connector",
  "version": "0.1.0",
  "description": "Scholaracle Local Connector (Node CLI) - uploads normalized academic data to Scholaracle",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "slc": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/cli.ts",
    "test": "jest --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@scholaracle/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}


