{
  "name": "@scholaracle/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "private": true,
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@scholaracle/contracts": "file:../contracts",
    "@scholaracle/scraper-core": "file:../scraper-core",
    "expo": "~57.0.11",
    "expo-constants": "^57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "ensure-dev-seed": "node scripts/ensure-companion-dev-seed.js",
    "test": "npm run ensure-dev-seed && jest",
    "test:coverage": "npm run ensure-dev-seed && jest --coverage",
    "lint": "eslint src App.tsx --ext .ts,.tsx",
    "lint:strict": "eslint src App.tsx --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src App.tsx --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" App.tsx",
    "type-check": "npm run ensure-dev-seed && tsc --noEmit",
    "clean": "rm -rf coverage dist .expo"
  }
}
