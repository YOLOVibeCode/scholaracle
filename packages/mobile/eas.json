{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "http://localhost:2801"
      },
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-uat.scholarmancy.com",
        "EAS_USE_CACHE": "1",
        "EAS_GRADLE_CACHE": "1"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.scholarmancy.com",
        "EAS_USE_CACHE": "1",
        "EAS_GRADLE_CACHE": "1"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle",
        "resourceClass": "medium"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "apple@darkware.net",
        "appleTeamId": "N42FM5L5KD",
        "ascAppId": "6798499288",
        "ascApiKeyPath": "$ASC_API_KEY_PATH",
        "ascApiKeyIssuerId": "69a6de75-883e-47e3-e053-5b8c7c11a4d1",
        "ascApiKeyId": "RA29BTM8KJ"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "completed",
        "changesNotSentForReview": true
      }
    },
    "production": {
      "ios": {
        "appleId": "apple@darkware.net",
        "appleTeamId": "N42FM5L5KD",
        "ascAppId": "6798499288",
        "ascApiKeyPath": "$ASC_API_KEY_PATH",
        "ascApiKeyIssuerId": "69a6de75-883e-47e3-e053-5b8c7c11a4d1",
        "ascApiKeyId": "RA29BTM8KJ",
        "language": "en-US",
        "metadataPath": "./store-metadata"
      },
      "android": {
        "track": "alpha",
        "releaseStatus": "completed",
        "changesNotSentForReview": true
      }
    }
  }
}
