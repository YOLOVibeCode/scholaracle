# ---------------------------------------------------------------------------
# CREDENTIALS — never commit. Companion stores secrets in device Keychain.
# Local testing: copy companion.env.example → companion.env.local
# (Do NOT use .env* names for companion secrets — Expo Metro would Babel-parse them.)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
companion.env.local
src/credentials/companionDevSeed.generated.ts
*.credentials.json
credentials.json
secrets.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
