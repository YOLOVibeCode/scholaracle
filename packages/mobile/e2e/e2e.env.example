# Copy to ~/.config/scholarmancy/e2e.env (outside the repo) and replace the
# placeholders with op:// references to 1Password items. Never put values here.
# scripts/e2e.sh reads this file through `opx run --env-file`.
MAESTRO_PARENT_EMAIL=op://<vault>/<parent-test-account-item-id-placeholder>/username
MAESTRO_PARENT_PASSWORD=op://<vault>/<parent-test-account-item-id-placeholder>/password
# Must match the student's name as the app shows it.
MAESTRO_STUDENT_NAME=op://<vault>/<parent-test-account-item-id-placeholder>/student_name
# skyward | canvas
MAESTRO_PORTAL_PROVIDER=op://<vault>/<portal-item-id-placeholder>/provider
MAESTRO_PORTAL_URL=op://<vault>/<portal-item-id-placeholder>/url
MAESTRO_PORTAL_USERNAME=op://<vault>/<portal-item-id-placeholder>/username
MAESTRO_PORTAL_PASSWORD=op://<vault>/<portal-item-id-placeholder>/password
