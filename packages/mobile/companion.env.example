# Companion local testing ONLY.
# Copy to companion.env.local (gitignored) and fill in real values.
# NEVER put real passwords in this example file.
# NEVER use EXPO_PUBLIC_* for passwords — those get baked into the JS bundle.
#
# IMPORTANT: Do NOT name this file .env* — Expo Metro require.context(/^\.\/\.env/)
# would treat it as a JS module and crash the bundle.
#
# Runtime: metro.config.js loads companion.env.local in __DEV__ only,
# then writes a gitignored seed module so portal creds can seed SecureStore.
# Production builds never read this file.

# Portal seed credentials for local sync testing (SecureStore import in __DEV__)
COMPANION_PORTAL_PROVIDER=canvas
COMPANION_PORTAL_BASE_URL=https://yourschool.instructure.com
COMPANION_PORTAL_USERNAME=
COMPANION_PORTAL_PASSWORD=
COMPANION_STUDENT_EXTERNAL_ID=dev-student
COMPANION_SOURCE_ID=dev-source
