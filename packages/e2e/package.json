{
  "name": "@scholaracle/e2e",
  "version": "1.0.0",
  "private": true,
  "description": "End-to-end tests for Scholaracle",
  "scripts": {
    "test": "echo 'E2E tests skipped in unit test run. Use: pnpm run test:e2e'",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:codegen": "playwright codegen ${BASE_URL:-http://localhost:2800}",
    "test:production": "BASE_URL=${BASE_URL:-https://scholarmancy.com} API_BASE_URL=${API_BASE_URL:-https://api.scholarmancy.com} playwright test --project=critical",
    "test:staging": "BASE_URL=${BASE_URL:-https://staging.scholarmancy.com} API_BASE_URL=${API_BASE_URL:-https://staging-api.scholarmancy.com} playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.10.0",
    "@types/speakeasy": "^2.0.10",
    "speakeasy": "^2.0.0",
    "typescript": "^5.3.0"
  }
}
