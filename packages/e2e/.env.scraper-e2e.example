# Scraper E2E test – required only when running the full scraper-generation E2E suite.
# Copy to .env.scraper-e2e and set real values. The suite is skipped if any variable is missing.
#
# Canvas LMS (e.g. LDISD)
TEST_CANVAS_URL=https://ldisd.instructure.com
TEST_CANVAS_EMAIL=29alewis@ldisd.net
TEST_CANVAS_PASSWORD=

# Skyward Family Access – use your district’s Skyward login URL and parent credentials.
# Obtain the exact Family Access URL from your district (e.g. LDISD). 
# Example format: https://skyward.iscorp.com/scripts/wsisa.dll/WService=wsedudistrictid/seplog01.w
TEST_SKYWARD_URL=
TEST_SKYWARD_USERNAME=jessica.lewis
TEST_SKYWARD_PASSWORD=
