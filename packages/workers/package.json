{
  "name": "@scholaracle/workers",
  "version": "1.0.0",
  "description": "Background workers for Scholaracle",
  "main": "dist/worker.js",
  "types": "dist/worker.d.ts",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/worker.js",
    "dev": "ts-node-dev --respawn --transpile-only src/worker.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@scholaracle/agents": "workspace:*",
    "@scholaracle/contracts": "workspace:*",
    "@scholaracle/database": "workspace:^",
    "@scholaracle/interfaces": "workspace:*",
    "@sendgrid/mail": "^8.1.0",
    "firebase-admin": "^12.0.0",
    "mongodb": "^6.3.0",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
