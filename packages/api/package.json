{
  "name": "@scholaracle/api",
  "version": "1.0.0",
  "description": "API server for Scholaracle",
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@scholaracle/agents": "workspace:*",
    "@scholaracle/auth": "workspace:^",
    "@scholaracle/contracts": "workspace:*",
    "@scholaracle/database": "workspace:^",
    "@scholaracle/interfaces": "workspace:*",
    "@sendgrid/mail": "^8.1.0",
    "@types/archiver": "^7.0.0",
    "archiver": "^7.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.3.0",
    "playwright": "^1.58.2",
    "rrule": "^2.7.2",
    "square": "^44.0.0",
    "twilio": "^5.0.0",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/helmet": "^4.0.0",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3",
    "speakeasy": "^2.0.0",
    "@types/speakeasy": "^2.0.10"
  }
}