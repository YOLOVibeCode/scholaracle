{
  "name": "@scholaracle/interfaces",
  "version": "1.0.0",
  "description": "Interface definitions for Scholaracle notification system (ISP)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "echo \"No tests for interfaces package\"",
    "lint": "eslint src --ext .ts",
